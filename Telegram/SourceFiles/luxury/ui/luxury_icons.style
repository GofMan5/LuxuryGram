using "ui/colors.palette";
using "ui/chat/chat.style";
using "ui/widgets/widgets.style";
using "dialogs/dialogs.style";

luxuryGhostIcon: icon {{ "luxury/ghost", menuIconColor }};
luxuryGhostModeGlobalIcon: icon {{ "luxury/ghost_mode_global", historyPeerUserpicFg }};
luxuryEditsHistoryIcon: icon {{ "luxury/edits_history", menuIconColor }};
luxuryLReadMenuIcon: icon {{ "luxury/lread", menuIconColor }};
luxurySReadMenuIcon: icon {{ "luxury/sread", menuIconColor }};
luxuryStreamerModeMenuIcon: icon {{ "luxury/streamer", menuIconColor }};
luxuryToBeginningMenuIcon: icon {{ "luxury/to_beginning", menuIconColor }};
luxuryRepeatMenuIcon: icon {{ "luxury/repeat", menuIconColor }};
luxuryContactsMutualIcon: icon {{ "luxury/contacts_mutual", contactsStatusFg }};
luxuryContactsMutualIconOver: icon {{ "luxury/contacts_mutual", contactsStatusFgOver }};

messageFieldAttachIcon: icon {{ "luxury/message_field/attach", menuIconColor }};
messageFieldCommandsIcon: icon {{ "luxury/message_field/commands", menuIconColor }};
messageFieldEmojiIcon: icon {{ "luxury/message_field/emoji", menuIconColor }};
messageFieldVoiceIcon: icon {{ "luxury/message_field/voice", menuIconColor }};
messageFieldTTLIcon: icon {{ "luxury/message_field/ttl", menuIconColor }};
messageFieldCocoonAiIcon: icon{
	{ size(24px, 24px), transparent },
	{ "chat/ai_letters-20x20", menuIconColor, point(2px, 2px) },
	{ "chat/ai_star1-20x20", menuIconColor, point(2px, 2px) },
	{ "chat/ai_star2-20x20", menuIconColor, point(2px, 2px) },
};

inChannelBadgeIcon: icon {{ "luxury/channel", msgInDateFg }};
inChannelBadgeSelectedIcon: icon {{ "luxury/channel", msgInDateFgSelected }};
outChannelBadgeIcon: icon {{ "luxury/channel", msgOutDateFg }};
outChannelBadgeSelectedIcon: icon {{ "luxury/channel", msgOutDateFgSelected }};


winEnterWithGuestIcon: icon {{ "luxury/ghost_tray", windowFg }};

editedIcon: IconEmoji{
    icon: icon{{ "luxury/edited", windowFg }};
    padding: margins(0px, 0px, 0px, 0px);
    useIconColor: false;
}

deletedIcon: IconEmoji{
    icon: icon{{ "luxury/trash_bin", windowFg }};
    padding: margins(0px, 0px, 0px, 0px);
    useIconColor: false;
}

burntIcon: IconEmoji{
    icon: icon{{ "luxury/burnt", windowFg }};
    padding: margins(0px, 0px, 0px, 0px);
    useIconColor: false;
}

luxuryHistoryFileInPlugin: icon {{ "luxury/history_file_plugin", historyFileInIconFg }};
luxuryHistoryFileInPluginSelected: icon {{ "luxury/history_file_plugin", historyFileInIconFgSelected }};
luxuryHistoryFileOutPlugin: icon {{ "luxury/history_file_plugin", historyFileOutIconFg }};
luxuryHistoryFileOutPluginSelected: icon {{ "luxury/history_file_plugin", historyFileOutIconFgSelected }};

menuIconClearAttention: icon {{ "menu/clear", menuIconAttentionColor }};
