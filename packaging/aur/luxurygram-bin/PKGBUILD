package() {
  install -Dm755 "${_appname}/${_appname}" "${pkgdir}/usr/bin/${_appname}"
  ln -s "${_appname}" "${pkgdir}/usr/bin/luxurygram"

  # pacman owns updates: the built-in updater stays off for this path.
  install -dm755 "${pkgdir}/usr/share/LuxuryGramDesktop/externalupdater.d"
  echo "/usr/bin/${_appname}" \
    > "${pkgdir}/usr/share/LuxuryGramDesktop/externalupdater.d/${pkgname}.conf"

  install -Dm644 "${_appid}-${pkgver}.desktop" \
    "${pkgdir}/usr/share/applications/${_appid}.desktop"
  install -Dm644 "${_appid}-${pkgver}.metainfo.xml" \
    "${pkgdir}/usr/share/metainfo/${_appid}.metainfo.xml"
  sed "s|@CMAKE_INSTALL_FULL_BINDIR@|/usr/bin|" "${_appid}-${pkgver}.service" \
    | install -Dm644 /dev/stdin "${pkgdir}/usr/share/dbus-1/services/${_appid}.service"

  local size
  for size in 16 32 48 64 128 256 512; do
    install -Dm644 "icon${size}-${pkgver}.png" \
      "${pkgdir}/usr/share/icons/hicolor/${size}x${size}/apps/${_appid}.png"
  done
  local symbolic="${pkgdir}/usr/share/icons/hicolor/symbolic/apps"
  install -Dm644 "tray-${pkgver}.svg" "${symbolic}/${_appid}-symbolic.svg"
  install -Dm644 "tray-attention-${pkgver}.svg" "${symbolic}/${_appid}-attention-symbolic.svg"
  install -Dm644 "tray-mute-${pkgver}.svg" "${symbolic}/${_appid}-mute-symbolic.svg"

  install -Dm644 "LICENSE-${pkgver}" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
