# Maintainer: GofMan5 <maksimka.ushanov0 at gmail dot com>

pkgname=luxurygram-bin
_appname=LuxuryGram
_appid=com.luxurygram.desktop
pkgver=1.0.20
pkgrel=1
pkgdesc='Telegram Desktop fork with privacy controls, anti-recall tools and translation (prebuilt binary)'
arch=('x86_64')
url='https://github.com/GofMan5/LuxuryGram'
# The OpenSSL linking exception is in the installed LICENSE: SPDX has no
# identifier for it that namcap accepts after WITH.
license=('GPL-3.0-or-later')
# The binary links the first group directly; the second group is loaded
# through implib-gen stubs, which abort the app when the library is missing.
depends=(
  'cairo'
  'fontconfig'
  'freetype2'
  'glib2'
  'glibc'
  'hicolor-icon-theme'
  'pango'

  'gdk-pixbuf2'
  'gtk3'
  'libdrm'
  'libglvnd'
  'libva'
  'libvdpau'
  'libx11'
  'libxcb'
  'systemd-libs'
  'wayland'
)
optdepends=(
  'alsa-lib: audio without PulseAudio or PipeWire'
  'libpulse: audio through PulseAudio or PipeWire'
  'webkit2gtk-4.1: embedded browser for mini apps and Instant View'
  'xcb-util-keysyms: global shortcuts on X11'
  'xdg-desktop-portal: native file dialogs and desktop integration'
  'xdg-utils: opening links and files in other applications'
)
provides=('luxurygram')
conflicts=('luxurygram')
options=('!strip' '!debug')
_tag="luxury-v${pkgver}"
_raw="https://raw.githubusercontent.com/GofMan5/LuxuryGram/${_tag}"
source=(
  "${_appname}-${pkgver}-linux-x64.tar.xz::${url}/releases/download/${_tag}/${_appname}-${pkgver}-linux-x64.tar.xz"
  "${_appid}-${pkgver}.desktop::${_raw}/lib/xdg/${_appid}.desktop"
  "${_appid}-${pkgver}.service::${_raw}/lib/xdg/${_appid}.service"
  "${_appid}-${pkgver}.metainfo.xml::${_raw}/lib/xdg/${_appid}.metainfo.xml"
  "icon16-${pkgver}.png::${_raw}/Telegram/Resources/art/icon16.png"
  "icon32-${pkgver}.png::${_raw}/Telegram/Resources/art/icon32.png"
  "icon48-${pkgver}.png::${_raw}/Telegram/Resources/art/icon48.png"
  "icon64-${pkgver}.png::${_raw}/Telegram/Resources/art/icon64.png"
  "icon128-${pkgver}.png::${_raw}/Telegram/Resources/art/icon128.png"
  "icon256-${pkgver}.png::${_raw}/Telegram/Resources/art/icon256.png"
  "icon512-${pkgver}.png::${_raw}/Telegram/Resources/art/icon512.png"
  "tray-${pkgver}.svg::${_raw}/Telegram/Resources/icons/tray_monochrome.svg"
  "tray-attention-${pkgver}.svg::${_raw}/Telegram/Resources/icons/tray_monochrome_attention.svg"
  "tray-mute-${pkgver}.svg::${_raw}/Telegram/Resources/icons/tray_monochrome_mute.svg"
  "LICENSE-${pkgver}::${_raw}/LICENSE"
)
