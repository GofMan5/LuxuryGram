pkgbase = luxurygram-bin
	pkgdesc = Telegram Desktop fork with privacy controls, anti-recall tools and translation (prebuilt binary)
	pkgver = 1.0.21
	pkgrel = 1
	url = https://github.com/GofMan5/LuxuryGram
	arch = x86_64
	license = GPL-3.0-or-later
	depends = cairo
	depends = fontconfig
	depends = freetype2
	depends = glib2
	depends = glibc
	depends = hicolor-icon-theme
	depends = pango
	depends = gdk-pixbuf2
	depends = gtk3
	depends = libdrm
	depends = libglvnd
	depends = libva
	depends = libvdpau
	depends = libx11
	depends = libxcb
	depends = systemd-libs
	depends = wayland
	optdepends = alsa-lib: audio without PulseAudio or PipeWire
	optdepends = libpulse: audio through PulseAudio or PipeWire
	optdepends = webkit2gtk-4.1: embedded browser for mini apps and Instant View
	optdepends = xcb-util-keysyms: global shortcuts on X11
	optdepends = xdg-desktop-portal: native file dialogs and desktop integration
	optdepends = xdg-utils: opening links and files in other applications
	provides = luxurygram
	conflicts = luxurygram
	options = !strip
	options = !debug
