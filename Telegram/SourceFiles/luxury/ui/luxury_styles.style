using "ui/basic.style";
using "ui/colors.palette";
using "ui/widgets/widgets.style";
using "info/info.style";
using "settings/settings.style";

iconPickerSelectedPadding: 2px;
iconPickerSelectedRounding: 12px;
iconPickerImagePadding: 4px;
iconPickerIconSize: 64px;

recentStickersLimitPadding: margins(22px, 4px, 22px, 8px);
imageViewPadding: margins(22px, 10px, 22px, 10px);
imageViewInnerPadding: margins(16px, 16px, 16px, 16px);

botWebViewPanelHeightIncreased: 782px;
botWebViewPanelWidthIncreased: 512px;

stickerRoundingSize: 5px;

messageShotPadding: 4px;

topBarAdmins: IconButton {
	width: 40px;
	height: topBarHeight;

	icon: icon {{ "luxury/top_bar_admins", menuIconFg }};
	iconOver: icon {{ "luxury/top_bar_admins", menuIconFgOver }};
	iconPosition: point(4px, 11px);

	rippleAreaPosition: point(0px, 7px);
	rippleAreaSize: 40px;
	ripple: RippleAnimation(defaultRippleAnimation) {
		color: windowBgOver;
	}
}

topBarRecentActions: IconButton {
	width: 40px;
	height: topBarHeight;

	icon: icon {{ "luxury/top_bar_recent_actions", menuIconFg }};
	iconOver: icon {{ "luxury/top_bar_recent_actions", menuIconFgOver }};
	iconPosition: point(4px, 11px);

	rippleAreaPosition: point(0px, 7px);
	rippleAreaSize: 40px;
	ripple: RippleAnimation(defaultRippleAnimation) {
		color: windowBgOver;
	}
}

unreadPillPadding: 12px;

infoProfileLabeledButtonRegistrationDate: IconButton(defaultIconButton) {
	width: 34px;
	height: 34px;
	icon: icon {{ "menu/calendar", windowActiveTextFg }};
	iconOver: icon {{ "menu/calendar", windowActiveTextFg }};
	rippleAreaPosition: point(0px, 0px);
	rippleAreaSize: 34px;
	ripple: defaultRippleAnimation;
}
registrationDateImportantTooltipLabel: FlatLabel(defaultImportantTooltipLabel) {
	style: TextStyle(defaultTextStyle) {
		font: font(12px);
	}
}

pluginShowInFolderIcon: icon {{ "menu/show_in_folder", boxTitleCloseFg }};
pluginShowInFolderIconOver: icon {{ "menu/show_in_folder", boxTitleCloseFgOver }};
pluginShowInFolder: IconButton(defaultIconButton) {
	width: boxTitleHeight;
	height: boxTitleHeight;

	icon: pluginShowInFolderIcon;
	iconOver: pluginShowInFolderIconOver;

	rippleAreaPosition: point(4px, 4px);
	rippleAreaSize: 40px;
	ripple: defaultRippleAnimationBgOver;
}
maxPluginDescriptionHeight: 400px;
pluginVersionAuthorLabel: FlatLabel(boxLabel) {
    align: align(center);
}
pluginChipSkip: 6px;

ghostPickerArrow: icon{{ "info/edit/expand_arrow_small", windowActiveTextFg }};

ghostPickerButton: LinkButton(defaultLinkButton) {
	color: windowActiveTextFg;
	overColor: windowActiveTextFg;
	font: font(boxFontSize);
	overFont: font(boxFontSize);
}

luxuryBetaBadgePadding: margins(4px, 1px, 4px, 1px);

luxuryServiceTimeBadgeFont: font(11px semibold);
luxuryServiceTimeBadgeHorizontalPadding: 7px;
luxuryServiceTimeBadgeVerticalPadding: 2px;
luxuryServiceTimeBadgeGap: 8px;
luxuryServiceTimeBadgeTrailingInset: 3px;
luxuryServiceTimeBadgeLastLineWidthAdd: 9px;

// Watcher box (luxury/ui/watcher/watcher_box.cpp and
// luxury/ui/watcher/watcher_components.cpp). Scalable geometry and type;
// surfaces and interaction colors follow the application theme.
luxuryWatcherCardRadius: 12px;
luxuryWatcherCardSkip: 10px;
luxuryWatcherCardPadding: margins(16px, 14px, 16px, 14px);
luxuryWatcherDetailSkip: 12px;
luxuryWatcherMetaSkip: 4px;
luxuryWatcherDetailPadding: 10px;
luxuryWatcherDetailRadius: 6px;
luxuryWatcherPreviewHeight: 100px;
luxuryWatcherDotSize: 10px;
luxuryWatcherPulseDiameter: 16px;
luxuryWatcherPillRadius: 12px;
luxuryWatcherPillPadding: margins(8px, 4px, 8px, 4px);

luxuryWatcherSortHeight: 32px;
luxuryWatcherControlInset: 10px;
luxuryWatcherSortSkip: 4px;
luxuryWatcherIconSize: 32px;
luxuryWatcherIconSkip: 8px;
luxuryWatcherClockSize: 14px;
luxuryWatcherTabHeight: 38px;
luxuryWatcherTabSkip: 3px;
luxuryWatcherHeaderSkip: 8px;
luxuryWatcherWidth: 520px;
luxuryWatcherViewHeight: 480px;
luxuryWatcherEmptyGlyphSize: 28px;
luxuryWatcherChipFont: font(12px semibold);
luxuryWatcherLabelFont: font(12px);
luxuryWatcherValueFont: font(12px semibold);
luxuryWatcherMarkFont: font(11px semibold);
luxuryWatcherSummaryLabel: FlatLabel(boxLabel) {
	minWidth: 1px;
	maxHeight: 0px;
	style: TextStyle(boxTextStyle) {
		font: font(14px semibold);
	}
}
luxuryWatcherValueLabel: FlatLabel(boxLabel) {
	minWidth: 1px;
	maxHeight: 0px;
	style: TextStyle(boxTextStyle) {
		font: font(14px);
	}
}
luxuryWatcherMetaLabel: FlatLabel(boxLabel) {
	minWidth: 1px;
	maxHeight: 0px;
	textFg: windowSubTextFg;
	style: TextStyle(boxTextStyle) {
		font: font(12px);
	}
}
luxuryWatcherIdentityLabel: FlatLabel(luxuryWatcherSummaryLabel) {
	maxHeight: 20px;
}
luxuryWatcherSettingsMenu: PopupMenu(defaultPopupMenu) {
	menu: Menu(defaultMenu) {
		itemPadding: margins(17px, 9px, 60px, 8px);
		itemToggleShift: 43px;
	}
}
luxuryWatcherAction: LinkButton(defaultLinkButton) {
	font: font(12px semibold);
	overFont: font(12px semibold);
	padding: margins(0px, 6px, 0px, 6px);
}
luxuryWatcherControl: LinkButton(defaultLinkButton) {
	font: font(12px semibold);
	overFont: font(12px semibold);
	padding: margins(10px, 6px, 10px, 6px);
}
